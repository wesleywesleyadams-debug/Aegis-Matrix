[node name="GripPoint" type="Marker3D" parent="." unique_id=186465344]
transform = Transform3D(0.182877, 0.837396, -0.515096, 0.96768, -0.060782, 0.244746, 0.17364, -0.543206, -0.821447, 0, -0.09363419, 0)
editor_description = "Rotate THIS marker to fix how THIS weapon alone sits in the hand -- it only affects this weapon, not other equipped items.
Unit.gd's _align_to_grip_point maps this marker's own local axes 1:1 onto the character's GripOffset axes, so which direction the weapon points depends on how this marker is rotated relative to the weapon's own mesh. For this Greatsword specifically, the blade points along this marker's local +X axis (computed directly from the Blade node's position relative to GripPoint).
If instead EVERY weapon in that hand looks wrong the same way, fix it on the character side (ParentUnit.tscn's GripOffset) instead of here."

