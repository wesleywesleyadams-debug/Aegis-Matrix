[node name="GripPoint" type="Marker3D" parent="." unique_id=1479558733]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.07822198, 0)
editor_description = "Rotate THIS marker to fix how THIS weapon alone sits in the hand -- it only affects this weapon, not other equipped items.
Unit.gd's _align_to_grip_point maps this marker's own local axes 1:1 onto the character's GripOffset axes, so which direction the weapon points depends on how this marker is rotated relative to the weapon's own mesh.
If instead EVERY weapon in that hand looks wrong the same way, fix it on the character side (ParentUnit.tscn's GripOffset) instead of here."

