[node name="GripPointLeft" type="Marker3D" parent="." unique_id=539990337]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.1)
editor_description = "Off-hand IK target for this weapon -- Unit.gd's _apply_left_hand_ik bends the left arm each frame to reach THIS marker's position (position only, not rotation), so the off-hand grips the fore-stock here.
Only affects this weapon's off-hand pose, not other equipped items."

