[node name="GripOffset" type="Marker3D" parent="ModelRoot/PeasantMale/Armature/Skeleton3D/WeaponSlot" unique_id=1966094185]
editor_description = "Rotate THIS node to correct how ALL weapons sit in this hand (a global fix affecting everything equipped here).
To fix just ONE weapon that looks wrong while others look fine, edit that weapon's own GripPoint marker instead (e.g. GreatswordBase.tscn's GripPoint) -- don't touch this node for a single-weapon fix.
Equipped items are parented directly onto this node and inherit its rotation (see Unit.gd _set_slot/_align_to_grip_point), so rotating GripOffset is the only runtime lever that affects every weapon at once.
GripAxisGizmo (child of GripMarker) shows this node's local axes: X=red, Y=green, Z=blue, arrowhead = positive/\"tip\" direction. Which axis is \"forward along the blade\" depends on how each weapon's own GripPoint was authored -- check in-game with Grip Points On to see which color lines up with a given weapon's blade."
transform = Transform3D(0.5, 1.3038516e-08, 0, 3.7252903e-09, 0.49999976, 9.313226e-09, -7.450581e-09, -3.981404e-08, 0.49999982, -0.0019095168, 0.05052483, 0.010017931)

